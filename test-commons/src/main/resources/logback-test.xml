<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %boldCyan(%-26.-26thread) %boldYellow(%-20.-20logger{0}) %highlight(%-6level) %msg%n%throwable</pattern>
        </encoder>
    </appender>

    <!-- BotCommands -->
    <logger name="io.github.freya022.botcommands" level="debug"/>

    <!-- Application command diff logs -->
    <logger name="io.github.freya022.botcommands.internal.commands.application.diff.DiffLogger" level="trace"/>

    <logger name="dev.freya02.botcommands.typesafe.messages" level="trace"/>

    <!-- Other logs -->
    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
